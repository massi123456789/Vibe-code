# Nombres de variables de entorno (solo nombres, nunca valores).
# En producción se configuran en el panel de Netlify:
# Site settings -> Environment variables
OPENAI_API_KEY=
JOOBLE_API_KEY=

# Token del panel privado de métricas (/.netlify/functions/admin-stats).
# Sin esta variable el panel devuelve 404 para todo el mundo.
ADMIN_STATS_TOKEN=

# Opcionales (tienen valores por defecto razonables):
# OPENAI_CV_MODEL=
# OPENAI_RANK_MODEL=
# MOCK_AI=
# MOCK_JOBS=
